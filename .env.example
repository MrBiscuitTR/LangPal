# LangPal configuration. Copy to .env.local and edit.
#
# .env.local is read at startup and never written to. Real environment
# variables win over anything set here.
#
# Every value below is optional; the defaults are in the CONFIGURATION block at
# the top of langpal.py. Settings a user can change from the browser (system
# prompt, temperature, language, voice) live in that browser's localStorage,
# not here -- these are only the server-side defaults and the secrets.

# --- where LangPal listens -------------------------------------------------

# 127.0.0.1 keeps it on this machine. Use your WireGuard address to let peers in.
LANGPAL_HOST=127.0.0.1
LANGPAL_PORT=8080

# TLS. Required for microphone access from anything other than localhost,
# because browsers only expose getUserMedia in a secure context.
# The certificate must carry a subjectAltName for the address you browse to.
# See docs/hosting.md for the openssl command.
#LANGPAL_TLS_CERT=C:\Users\you\LangPal\cert.pem
#LANGPAL_TLS_KEY=C:\Users\you\LangPal\key.pem

# Shared password. Leave unset for no authentication, which is only reasonable
# on loopback or inside a tunnel you control.
#LANGPAL_TOKEN=choose-something-long

# --- upstream endpoints ----------------------------------------------------
#
# Base URLs, not full endpoint paths. A missing scheme, a trailing slash or a
# trailing /v1 are all fixed up automatically; a routing prefix such as
# /upstream/omnivoice is preserved.
#
# Note: llama-swap routes by the "model" field in the request body, and
# GET /v1/audio/voices has no body. Point the TTS URL at the container directly
# (http://127.0.0.1:8123) or at llama-swap's per-model route
# (http://10.66.66.2:11435/upstream/omnivoice). Pointing it at plain
# http://10.66.66.2:11435 makes voice listing fail with "no model id could be
# identified".

LANGPAL_LLM_URL=http://10.66.66.2:11435
LANGPAL_STT_URL=http://10.66.66.2:11435
LANGPAL_TTS_URL=http://127.0.0.1:8123

LANGPAL_LLM_MODEL=gemma4-26b-a4b
LANGPAL_STT_MODEL=qwen3-asr
LANGPAL_TTS_MODEL=omnivoice

# Bearer tokens, if an upstream needs one. Server-side only: these are never
# sent to the browser and cannot be set from it. Local llama.cpp needs none.
#LANGPAL_LLM_API_KEY=
#LANGPAL_STT_API_KEY=
#LANGPAL_TTS_API_KEY=

# --- defaults the browser can override -------------------------------------

# "auto" lets Qwen3-ASR detect the language and speaks the reply back in it.
# Pin a language name (not an ISO code) for reliable results on short clips.
#LANGPAL_LANGUAGE=Turkish

# Voice to speak with. Blank uses the TTS server's own default.
#LANGPAL_VOICE=en_nature

# Messages of history replayed as context (user + assistant counted together).
#LANGPAL_HISTORY_MESSAGES=20

# Replaces the built-in conversation-partner prompt entirely.
#LANGPAL_SYSTEM_PROMPT=You are a patient language tutor. Keep replies short.

# --- default voices --------------------------------------------------------

# Folder of WAV clips registered as cloned voices at startup. Each name.wav may
# be paired with name.txt holding its transcript; without one, the clip is
# transcribed by the STT model. The folder is only ever read.
#LANGPAL_VOICES_DIR=C:\Users\you\LangPal\voices_default
#LANGPAL_REGISTER_DEFAULT_VOICES=true
